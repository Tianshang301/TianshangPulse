# TianshangPulse — common sdkconfig (applies to all targets)
# Target-specific settings live in sdkconfig.defaults.<TARGET>

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_OPTIMIZED_SCHEDULER=y

# BLE (NimBLE host + controller)
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# I2C bus (shared by MAX30102 + MPU6886)
CONFIG_SENSOR_I2C_PORT=0

# PPG simulation (off by default; enable on boards without MAX30102)
CONFIG_SENSOR_SIM_PPG=n

# LVGL UI (status screen uses the 24px font for HR digits)
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_24=y

# Main task stack: app_main now runs the whole display bring-up synchronously
# (SPI bus + esp_lcd panel + esp_lvgl_port + LVGL object/theme creation), which
# is stack-hungry. 3584 (IDF default) is too tight for that; 8192 leaves margin.
# Verify on hardware via uxTaskGetStackHighWaterMark(NULL) logged after ui_init().
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
