# TianshangPulse — common sdkconfig (applies to all targets)
# Target-specific settings live in sdkconfig.defaults.<TARGET>

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_OPTIMIZED_SCHEDULER=y
# Idle task stack. app_main is pinned to CPU0, so CPU0's idle task does all the
# PSRAM cache critical-section work. The 1536B default overflows on OPI PSRAM
# (ESP32-S3 N16R8) and kills the core right after "cpu_start: Multicore app".
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=3072
# Bump the shared minimal stack used by portSTARTup before task stacks exist.
# Too-small here masks as "core dies right after cpu_start: Multicore app" with no
# panic banner (log UART isn't up yet to print one).
# 2026-09-24 bring-up: 3072 was NOT enough with OPI PSRAM + dual core (app reset
# in a ~9s loop right after "cpu_start: Multicore app"). OPI PSRAM needs deeper
# cache critical sections -> 8192.
CONFIG_ESP_MINIMAL_SHARED_STACK_SIZE=8192

# ---- TEMPORARY hardware bring-up diagnostics (revert once boot is clean) ----
# 1) Bootloader RTC WDT. IDF default is 9000ms and it is still armed during the
#    app's early start-up (esp_int_wdt only re-arms it later), so any slow early
#    phase shows up as a 9s reboot loop with reason rst:0x10 (RTCWDT_RTC_RST)
#    and no panic banner. 30s separates "slow" from "hard hang".
CONFIG_BOOTLOADER_WDT_TIME_MS=30000
# 2) Debug level so the early start-up markers are actually compiled in and
#    printed: "Starting app cpu, entry point is ..." (cpu_start.c:283) and
#    "Pro cpu up" (cpu_start.c:616). These prove how far the boot gets.
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y

# Power management. power_manager_init() calls esp_pm_configure(); with
# CONFIG_PM_ENABLE unset that is a stub returning ESP_ERR_NOT_SUPPORTED, and the
# ESP_ERROR_CHECK at main.c aborts the whole boot. light_sleep_enable=true
# additionally requires the tickless-idle Kconfig below.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# BLE (NimBLE host + controller)
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# NimBLE host task stack: the IDF default 4096 is the bare floor and panics
# (Core 0 stack overflow) right after "cpu_start: Multicore app" on the ESP32-S3
# once SMP + GATT config run. 8192 is the documented safe value.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
CONFIG_BT_NIMBLE_TASK_STACK_SIZE=8192
# Roles: this device is a pure GATT Server (watch) - Peripheral + Broadcaster only.
# Central/Observer are compiled out to cut host stack depth.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n

# I2C bus (shared by MAX30102 + MPU6886)
CONFIG_SENSOR_I2C_PORT=0

# PPG simulation (off by default; enable on boards without MAX30102)
CONFIG_SENSOR_SIM_PPG=n

# LVGL UI (status screen uses the 24px font for HR digits)
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_24=y

# Main task stack: app_main now runs the whole display bring-up synchronously
# (SPI bus + esp_lcd panel + esp_lvgl_port + LVGL object/theme creation), which
# is stack-hungry. 3584 (IDF default) is too tight for that; 8192 leaves margin.
# Verify on hardware via uxTaskGetStackHighWaterMark(NULL) logged after ui_init().
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
